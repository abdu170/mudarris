# =============================================================================
# MUDARRIS — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development
# For staging/production, set these in your hosting provider's environment panel
# Never commit .env.local or any file containing real secrets
# =============================================================================

# -----------------------------------------------------------------------------
# APP ENVIRONMENT
# Values: local | staging | production
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Staging:   NEXT_PUBLIC_APP_URL=https://staging.mudarris.qa
# Production: NEXT_PUBLIC_APP_URL=https://mudarris.qa

# -----------------------------------------------------------------------------
# SUPABASE — Public (safe for browser)
# Get from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# SUPABASE — Server-only (never expose to client)
# Get from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# -----------------------------------------------------------------------------
# TAP PAYMENTS
# Get from: Tap Payments Dashboard → Developers → API Keys
# Use TEST keys for local/staging, LIVE keys for production only
# -----------------------------------------------------------------------------
TAP_SECRET_KEY=sk_test_your-tap-secret-key
TAP_PUBLISHABLE_KEY=pk_test_your-tap-publishable-key
TAP_WEBHOOK_SECRET=your-tap-webhook-hmac-secret

# -----------------------------------------------------------------------------
# RESEND — Transactional Email
# Get from: resend.com → API Keys
# From address must be a verified domain in Resend
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@mudarris.qa

# -----------------------------------------------------------------------------
# MERITHUB — Online Sessions
# Get from: Merithub partner dashboard
# Never expose MERITHUB_API_KEY to the frontend
# -----------------------------------------------------------------------------
MERITHUB_API_KEY=your-merithub-api-key
MERITHUB_BASE_URL=https://api.merithub.com

# -----------------------------------------------------------------------------
# UPSTASH REDIS — Rate Limiting (optional but recommended for production)
# Get from: console.upstash.com → Create Database → REST API
# If not set, rate limiting is skipped (acceptable for local dev)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------------------------------------
# POSTHOG — Product Analytics, Session Recording & Error Tracking
# Get from: PostHog → Project Settings → Project API Key
# If not set, analytics is skipped (acceptable for local dev)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# ENVIRONMENT CHECKLIST
# =============================================================================
# local:
#   - Use Supabase local CLI or a dedicated dev project
#   - TAP_SECRET_KEY must be a TEST key (sk_test_*)
#   - NEXT_PUBLIC_APP_URL=http://localhost:3000
#   - Upstash Redis optional
#
# staging:
#   - Use a separate Supabase project (not production)
#   - TAP_SECRET_KEY must be a TEST key (sk_test_*)
#   - NEXT_PUBLIC_APP_URL=https://staging.mudarris.qa
#   - Upstash Redis required
#
# production:
#   - Use production Supabase project with RLS verified
#   - TAP_SECRET_KEY must be LIVE key (sk_live_*) — do NOT use test key
#   - NEXT_PUBLIC_APP_URL=https://mudarris.qa
#   - Upstash Redis required
#   - All secrets rotated from staging values
# =============================================================================
